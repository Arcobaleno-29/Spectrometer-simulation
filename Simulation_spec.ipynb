    "\n",
    "center_wavelength_nm = CONFIG.spectrum.center_wavelength_nm\n",
    "center_results = {}\n",
    "for system in RESOLUTION_CHANGE_TEST.systems:\n",
    "    results = resolution_change_results[system.short_label]\n",
