     "text": [
      "Test wavelength: 551.70 nm\n",
      "POPPY pupil grid: 512×512\n",
      "Detector-plane oversampling: 8×\n",
      "Projected slit: 8.000 µm = 2.319 detector pixels\n",
      "Finite-grating contribution: 0.0724 nm = 0.197 pixels\n",
      "Final monochrome detector FWHM: 2.227 pixels\n",
      "Raw RGGB collapsed FWHM: 2.229 pixels\n",
      "Nyquist result: PASS — Nyquist sampling satisfied\n"
     ]
