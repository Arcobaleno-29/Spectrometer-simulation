    "    )\n",
    "    axes[0, 0].plot(\n",
    "        wavelengths_nm,\n",
    "        rss_nm,\n",
    "        color=system.color,\n",
    "        linestyle=\"--\",\n",
    "        linewidth=1.7,\n",
    "        label=f\"{system.short_label}: RSS estimate\",\n",
